package com.example.antidetectbrowser

import android.os.Bundle
import android.webkit.*
import androidx.appcompat.app.AppCompatActivity
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext

class BrowserActivity : AppCompatActivity() {
    private lateinit var webView: WebView
    private var profile: com.example.antidetectbrowser.models.Profile? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_browser)

        val profileId = intent.getIntExtra("PROFILE_ID", -1)
        webView = findViewById(R.id.webView)

        CoroutineScope(Dispatchers.IO).launch {
            profile = MainApplication.database.profileDao().getById(profileId)
            withContext(Dispatchers.Main) {
                setupWebView()
            }
        }
    }

    private fun setupWebView() {
        val settings = webView.settings
        settings.javaScriptEnabled = true
        settings.userAgentString = profile?.userAgent

        setProxyForWebView(profile?.proxyHost, profile?.proxyPort)

        webView.webViewClient = object : WebViewClient() {
            override fun onPageFinished(view: WebView?, url: String?) {
                injectAntiDetectJS()
                injectSimSpoofJS()
                injectGeoSpoofJS()
            }

            override fun onReceivedHttpAuthRequest(view: WebView?, handler: HttpAuthHandler?, host: String?, realm: String?) {
                if (profile?.proxyUsername != null && profile?.proxyPassword != null) {
                    handler?.proceed(profile!!.proxyUsername, profile!!.proxyPassword)
                } else {
                    super.onReceivedHttpAuthRequest(view, handler, host, realm)
                }
            }
        }

        findViewById<android.widget.Button>(R.id.btnGo).setOnClickListener {
            var url = findViewById<android.widget.EditText>(R.id.etUrl).text.toString()
            if (!url.startsWith("http")) url = "https://$url"
            webView.loadUrl(url)
        }

        webView.loadUrl("https://browserleaks.com")
    }

    private fun setProxyForWebView(host: String?, port: Int?) {
        if (host == null || port == null) return
        System.setProperty("http.proxyHost", host)
        System.setProperty("http.proxyPort", port.toString())
        System.setProperty("https.proxyHost", host)
        System.setProperty("https.proxyPort", port.toString())
    }

    private fun injectAntiDetectJS() {
        val tz = profile?.timezone ?: "UTC"
        val langs = profile?.languages ?: "en-US,en"

        val js = """
            (function() {
                // Canvas + WebGL noise
                const getContext = HTMLCanvasElement.prototype.getContext;
                HTMLCanvasElement.prototype.getContext = function(type) {
                    const ctx = getContext.apply(this, arguments);
                    if (type === '2d') {
                        const originalFillText = ctx.fillText;
                        ctx.fillText = function(text, x, y, maxWidth) {
                            x += (Math.random() - 0.5) * 2;
                            y += (Math.random() - 0.5) * 2;
                            return originalFillText.apply(this, [text, x, y, maxWidth]);
                        };
                    }
                    return ctx;
                };

                if (window.WebGLRenderingContext) {
                    const originalGetParameter = WebGLRenderingContext.prototype.getParameter;
                    WebGLRenderingContext.prototype.getParameter = function(parameter) {
                        if (parameter === 37445 || parameter === 37446) return 'Intel Inc.';
                        return originalGetParameter.apply(this, arguments);
                    };
                }

                // Hardware/Timezone/Languages
                Object.defineProperty(navigator, 'hardwareConcurrency', { get: () => 4 + Math.floor(Math.random() * 12) });
                Object.defineProperty(Intl.DateTimeFormat.prototype, 'resolvedOptions', { value: () => ({ timeZone: '$tz' }) });
                Object.defineProperty(navigator, 'languages', { get: () => ['$langs'.split(',')] });
                Object.defineProperty(navigator, 'deviceMemory', { get: () => 4 + Math.floor(Math.random() * 12) });
                Object.defineProperty(navigator, 'plugins', { get: () => [] });
            })();
        """.trimIndent()
        webView.evaluateJavascript(js, null)
    }

    private fun injectSimSpoofJS() {
        val phone = profile?.phoneNumber ?: "unknown"
        val operator = profile?.operator ?: "unknown"
        val country = profile?.countryCode ?: "unknown"

        val js = """
            (function() {
                window.phoneNumber = '$phone';
                window.operator = '$operator';
                window.countryCode = '$country';
            })();
        """.trimIndent()
        webView.evaluateJavascript(js, null)
    }

    private fun injectGeoSpoofJS() {
        val lat = profile?.latitude ?: 0.0
        val long = profile?.longitude ?: 0.0

        val js = """
            (function() {
                if ('geolocation' in navigator) {
                    navigator.geolocation.getCurrentPosition = function(success) {
                        success({
                            coords: {
                                latitude: $lat,
                                longitude: $long,
                                accuracy: 20
                            },
                            timestamp: Date.now()
                        });
                    };
                    navigator.geolocation.watchPosition = navigator.geolocation.getCurrentPosition;
                }
            })();
        """.trimIndent()
        webView.evaluateJavascript(js, null)
    }

    override fun onBackPressed() {
        if (webView.canGoBack()) webView.goBack() else super.onBackPressed()
    }

    override fun onDestroy() {
        System.clearProperty("http.proxyHost")
        System.clearProperty("https.proxyHost")
        super.onDestroy()
    }
} 
